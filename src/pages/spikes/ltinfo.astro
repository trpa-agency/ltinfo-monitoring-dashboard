---
// Decision 5 spike: LT Info content fetched at build in frontmatter (Node), with
// fixture fallback, rendered through the src/components/mon/ltinfo components.
// A QA page: one block per program, each stating where its data came from
// (live, fixture, or none), when it was fetched, and the counts, then every
// component. Programs: 41 (Ozone), 63 (Streams), and the first program with
// `ltinfo: false`, which reads its text from programs.json and makes no request.
//
// Set LTINFO_OFFLINE=1 on the dev server to see the fixture path.
import BaseLayout from '../../layouts/BaseLayout.astro';
import EsaCard from '@esa/ecology/esa-card.astro';
import EsaBadge from '@esa/ecology/esa-badge.astro';
import ProgramAbout from '../../components/mon/ltinfo/ProgramAbout.astro';
import Partners from '../../components/mon/ltinfo/Partners.astro';
import Indicators from '../../components/mon/ltinfo/Indicators.astro';
import Documents from '../../components/mon/ltinfo/Documents.astro';
import KeyPhoto from '../../components/mon/ltinfo/KeyPhoto.astro';
import DashboardFrame from '../../components/mon/ltinfo/DashboardFrame.astro';
import { allPrograms } from '../../lib/programs.ts';
import { loadProgramContent, programPageHref, type ProgramContent } from '../../lib/ltinfo-api.ts';
import '@esa/tokens/typography.css';

const entries = allPrograms();
const byId = (id: number) => entries.find((e) => e.program.id === id)?.program;
const picks = [byId(41), byId(63), entries.find((e) => e.program.ltinfo === false)?.program].filter(
  (p): p is NonNullable<typeof p> => !!p,
);
const contents: ProgramContent[] = await Promise.all(picks.map((p) => loadProgramContent(p)));

const badgeVariant = (source: ProgramContent['source']) =>
  source === 'live' ? 'success' : source === 'fixture' ? 'warning' : 'neutral';
const counts = (c: ProgramContent) =>
  [
    ['partners', c.partners.length],
    ['indicators', c.indicators.length],
    ['documents', c.documents.length],
    ['images', c.images.length],
    ['sites', c.sites.length],
    ['features', c.featureCollection.features.length],
  ] as const;
---
<BaseLayout title="LT Info content spike">
  <main class="ltinfo-spike">
    <h1 class="ltinfo-spike__title typography-title">LT Info content at build time</h1>
    <p class="ltinfo-spike__intro typography-body-md">
      Each block below was fetched from internalapi.laketahoeinfo.org while this page was built, or
      read from a recorded fixture when the API could not be reached. The line under each heading says which.
    </p>

    {contents.map((c) => (
      <section class="ltinfo-spike__program" aria-labelledby={`program-${c.program.id}`} data-program-id={c.program.id} data-source={c.source}>
        <h2 class="ltinfo-spike__heading typography-title-sm-strong" id={`program-${c.program.id}`}>
          {c.program.name} <span class="ltinfo-spike__id">(program {c.program.id})</span>
        </h2>
        <p class="ltinfo-spike__status typography-body-sm" data-status>
          <EsaBadge value={c.source} variant={badgeVariant(c.source)} size="xs" />
          {' '}source: <strong>{c.source}</strong>; fetchedAt: <strong>{c.fetchedAt ?? 'none'}</strong>;
          {counts(c).map(([k, n], i) => (
            <>{i ? ', ' : ' '}{k} <strong>{n}</strong></>
          ))}.
          {c.program.ltinfo === false ? (
            <> Text from programs.json (<code>ltinfo: false</code>); no request was made.</>
          ) : (
            <> Routes: {Object.entries(c.sources).map(([r, s]) => `${r}=${s}`).join(', ')}.{' '}
              {c.record && <a href={programPageHref(c.record)} target="_blank" rel="noopener">Program page on LT Info</a>}</>
          )}
        </p>

        <div class="ltinfo-spike__grid">
          <EsaCard title="About the program">
            <ProgramAbout record={c.record} />
          </EsaCard>
          <EsaCard title="Key photo">
            {c.images.length || c.record?.KeyImageFileResourceGUID ? (
              <KeyPhoto images={c.images} record={c.record} programName={c.program.name} />
            ) : (
              <p class="typography-body-sm ltinfo-spike__none">No key photo. KeyPhoto renders nothing here.</p>
            )}
          </EsaCard>
          <EsaCard title="Partners, indicators, and documents">
            <div class="ltinfo-spike__stack">
              <Partners partners={c.partners} relationshipLabel={c.record?.OrganizationRelationshipLabel} />
              <Indicators indicators={c.indicators} />
              <Documents documents={c.documents} />
            </div>
          </EsaCard>
          <EsaCard title="Program dashboard">
            {c.record?.Dashboard ? (
              <DashboardFrame dashboard={c.record.Dashboard} programName={c.program.name} selfHref={Astro.url.href} />
            ) : (
              <p class="typography-body-sm ltinfo-spike__none">No Dashboard on the record. DashboardFrame renders nothing here.</p>
            )}
          </EsaCard>
        </div>
      </section>
    ))}
  </main>
</BaseLayout>

<style>
  .ltinfo-spike {
    max-width: 1100px;
    margin: 0 auto;
    padding: var(--spacing-600, 2rem) var(--spacing-400, 1rem);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-600, 2rem);
  }
  .ltinfo-spike__title,
  .ltinfo-spike__intro,
  .ltinfo-spike__heading {
    margin: 0;
  }
  .ltinfo-spike__id {
    color: var(--color-content-default-secondary, #656565);
    font-weight: var(--typography-font-weight-regular, 400);
  }
  .ltinfo-spike__program {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-300, 0.75rem);
  }
  .ltinfo-spike__status {
    margin: 0;
    color: var(--color-content-default-secondary, #656565);
  }
  .ltinfo-spike__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: var(--spacing-400, 1rem);
  }
  .ltinfo-spike__stack {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-500, 1.5rem);
  }
  .ltinfo-spike__none {
    margin: 0;
    color: var(--color-content-default-secondary, #656565);
  }
</style>
