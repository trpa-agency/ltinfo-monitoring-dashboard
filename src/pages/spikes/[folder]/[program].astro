---
// One prerendered dashboard page per program in programs.json, at
// /spikes/<category folder>/<program file>, for example
// /spikes/air-quality/ozone.html. build.format 'file' writes each route as its
// own .html file so the LT Info admin can point a Dashboard card at it.
import Program from '../../../layouts/Program.astro';
import { allPrograms, programSlug, templateOf, type Category, type Program as ProgramRecord, type Template } from '../../../lib/programs.ts';

export function getStaticPaths() {
  return allPrograms().map(({ program, category }) => ({
    params: { folder: category.folder, program: programSlug(program) },
    props: { program, category, template: templateOf(program) },
  }));
}

interface Props {
  program: ProgramRecord;
  category: Category;
  template: Template;
}
const { program, category, template } = Astro.props;
---
<Program program={program} category={category} template={template} />
