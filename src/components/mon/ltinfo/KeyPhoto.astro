---
// mon-lego-checked: no esa-* is a captioned image (esa-avatar is a round
// identity mark), so this is a plain <figure> with a <figcaption> on tokens.
//
// KeyPhoto: the program's key image from GET /monitoring-programs/{id}/images
// (the image flagged IsKeyPhoto, else the first, else the record's own
// KeyImageFileResourceGUID), with its caption and photo credit. Renders nothing
// when the program has no image. Fetches nothing. The image loads lazily from
// internalapi.laketahoeinfo.org/file-resources/{guid}, which answers an
// anonymous GET with the image bytes.
import '@esa/tokens/typography.css';
import type { ProgramImage, ProgramRecord } from '../../../lib/ltinfo-api';
import { keyPhoto } from '../../../lib/ltinfo-api';

interface Props {
  images: ProgramImage[] | null | undefined;
  /** The record, for its KeyImageFileResourceGUID when the images route has none. */
  record?: ProgramRecord | null;
  /** The program name, for the alt text when the image has no caption. */
  programName?: string;
  /** Constrain the figure to a height; the image covers it. Default: natural height, max 360 px. */
  height?: string;
}
const { images, record = null, programName = 'the program', height } = Astro.props;
const photo = keyPhoto(images, record);
const alt = photo ? photo.caption || `Key photo for ${programName}` : '';
const credit = photo?.credit ? `Photo: ${photo.credit}` : '';
---
{photo && (
  <figure class="mon-key-photo" style={height ? `--mon-key-photo-height: ${height}` : undefined}>
    <img class="mon-key-photo__img" src={photo.url} alt={alt} loading="lazy" decoding="async" />
    {(photo.caption || credit) && (
      <figcaption class="mon-key-photo__caption typography-meta">
        {photo.caption && <span>{photo.caption}</span>}
        {photo.caption && credit && ' '}
        {credit && <span class="mon-key-photo__credit">{credit}</span>}
      </figcaption>
    )}
  </figure>
)}

<style>
  .mon-key-photo {
    --mon-key-photo-height: auto;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-150, 0.375rem);
  }
  .mon-key-photo__img {
    display: block;
    width: 100%;
    height: var(--mon-key-photo-height);
    max-height: 360px;
    object-fit: cover;
    border-radius: var(--radius-md, 0.5rem);
    background: var(--color-background-default-secondary, #efefef);
  }
  .mon-key-photo__caption {
    margin: 0;
    color: var(--color-content-default-secondary, #656565);
  }
  .mon-key-photo__credit {
    color: var(--color-content-default-tertiary, #8a8a8a);
  }
</style>
