---
// Program: the layout for one monitoring program dashboard. Standalone it has
// the LT Info chrome (StandaloneChrome); framed in the Dashboard card on
// monitoring.laketahoeinfo.org the chrome is hidden and only <main> remains,
// on the card body color, posting its height to the parent (src/lib/embed.ts).
//
// The body is a row of four esa-stat tiles and the five sections of
// ProgramSections, ordered by the template (charts, map, or context). The page
// passes the template from programs.json; ?template= in the URL overrides it
// at runtime by setting data-template on <main>.
//
// The tiles start as summaryTiles() computes them before any data (the loading
// mark when a source exists, "n/a" with the reason when none does) and the
// script at the bottom updates them from the panels' events as rows arrive.
import BaseLayout from './BaseLayout.astro';
import StandaloneChrome from '../components/mon/StandaloneChrome.astro';
import ProgramSections from '../components/mon/ProgramSections.astro';
import EsaCard from '@esa/ecology/esa-card.astro';
import EsaStat from '@esa/ecology/esa-stat.astro';
import { DEFAULT_TEMPLATE, type Category, type Program, type Template } from '../lib/programs.ts';
import { initialTileState, summaryTiles, type GeoJsonSitesConfig } from '../lib/sites.ts';
import type { ProgramContent } from '../lib/ltinfo-api.ts';
import '@esa/tokens/layouts.css';

interface Props {
  program: Program;
  category: Category;
  template?: Template;
  /** LT Info sites hook, forwarded to ProgramSections; see its Props. */
  geojson?: GeoJsonSitesConfig;
  /** Build-time LT Info content (record, partners, indicators, documents, images), forwarded to ProgramSections. */
  content?: ProgramContent;
}
const { program, category, template = DEFAULT_TEMPLATE, geojson, content } = Astro.props;

const hasSiteSource = !!(program.sitesLayer || program.mapLayer || geojson);
const chartCount = (program.measures?.length ?? 0) + (program.sitesPerYear ? 1 : 0);
const tiles = summaryTiles(initialTileState(hasSiteSource, chartCount));
---
<BaseLayout title={`${program.name} | Monitoring Dashboard`}>
  <!-- Runs as the body parses, before any chrome paints, so a framed page never
       flashes the standalone shell. src/lib/embed.ts repeats the check after
       load and does the rest. (The hub's Handoff inspector, whose gate fetch
       used to log a 404 on every page, is mounted by BaseLayout only when the
       route has a bundle on disk, so program pages load with a clean console.) -->
  <script is:inline>
    if (window.self !== window.top) document.documentElement.classList.add('is-embed');
  </script>

  <div class="mon-page">
    <StandaloneChrome program={program} category={category}>
      <main
        id="main"
        class="mon-main stack"
        data-gap="md"
        data-template={template}
        data-program-id={program.id}
        data-site-source={hasSiteSource ? 'true' : 'false'}
      >
        <div class="mon-stats grid" data-gap="md" aria-label="Program summary">
          {tiles.map((tile) => (
            <EsaCard padding="compact">
              <div class="mon-stat" data-tile={tile.key}>
                <EsaStat value={tile.value} label={tile.label} sub={tile.sub} />
              </div>
            </EsaCard>
          ))}
        </div>
        <ProgramSections program={program} category={category} template={template} geojson={geojson} content={content} />
        <slot />
      </main>
    </StandaloneChrome>
  </div>

  <style is:global>
    /* The page is the LT Info card body color standalone and framed alike; the
       theme pins --color-background-default to #f7f7f7. `html body` outranks the
       base layout's `body` rule whichever stylesheet lands first. */
    html body {
      background: var(--color-background-default, #f7f7f7);
    }
    /* Framed: no chrome. The class is set inline above and again by embed.ts,
       which also sets `hidden`; the author `display` on the legos would beat
       the hidden attribute alone, hence the rule. */
    html.is-embed [data-standalone],
    [data-standalone][hidden] {
      display: none !important;
    }
    /* Framed: the container gutter shrinks to the 12 px the current dashboards
       use inside the card body, which has padding of its own. */
    html.is-embed .esa-container {
      padding-inline: var(--spacing-300, 12px);
    }
  </style>

  <style>
    .mon-page {
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }
    /* Framed, the page must not size itself from the frame: the frame is sized
       from the page, and a 100vh floor would feed back into the height posts. */
    :global(html.is-embed) .mon-page {
      min-height: 0;
    }
    /* No min-width override on .mon-main. The sidebar primitive sets
       `.sidebar > :last-child { min-inline-size: var(--sidebar-content-min) }`
       (62 percent, set on .mon-layout in StandaloneChrome), and that minimum is
       what makes the side nav drop below the dashboard at phone widths. A
       `min-width: 0` here ties it in specificity and wins or loses by stylesheet
       order: it lost in the production bundle and won on the dev server, where
       main collapsed to 47 px beside the nav and the sections overflowed 375 px.
       Because the minimum is explicit, the flex item's automatic min-content
       floor does not apply, so wide content inside main cannot widen it. */
    :global(html.is-embed) .mon-main {
      padding-block: var(--spacing-300, 12px) var(--spacing-400, 16px);
    }
    .mon-stats {
      --grid-min: 10rem;
    }
    /* Phone widths, standalone or inside the Dashboard card: two tiles across
       instead of a four-row stack. The auto-fit grid cannot fit two 10rem tracks
       plus the gap in 311 px, so the column count is fixed here. */
    @media (max-width: 720px) {
      .mon-stats {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
    .mon-stat {
      min-width: 0;
    }
  </style>

  <script>
    import { initEmbed } from '../lib/embed.ts';
    import { initialTileState, recordYears, summaryTiles, type SitesSummary, type Tile } from '../lib/sites.ts';
    import type { PanelData } from '../components/mon/mon-chart-panel.ts';
    import type { MonChartPanel } from '../components/mon/mon-chart-panel.ts';
    import type { MonSitesPanel } from '../components/mon/mon-sites-panel.ts';

    initEmbed();

    // The four tiles follow the panels. Each panel posts its rows and its final
    // state as bubbling events; the state here is folded into summaryTiles() on
    // every event. Panels that settled before this script ran (the bundle order
    // is not guaranteed) are read back through their data and summary properties.
    const main = document.getElementById('main');
    if (main) {
      const chartPanels = [...main.querySelectorAll<MonChartPanel>('mon-chart-panel')];
      const sitesPanel = main.querySelector<MonSitesPanel>('mon-sites-panel');
      const state = initialTileState(main.dataset.siteSource === 'true', chartPanels.length);
      const years = new Set<number>();

      // esa-stat is an Astro lego with no runtime API, so its value and sub text
      // are set by class. The wrapper carries data-tile; the lego's class names
      // are the public markup of @esa/ecology/esa-stat.astro.
      const render = (): void => {
        state.years = [...years];
        for (const tile of summaryTiles(state) as Tile[]) {
          const el = main.querySelector<HTMLElement>(`[data-tile="${tile.key}"]`);
          const value = el?.querySelector<HTMLElement>('.esa-stat__value');
          const sub = el?.querySelector<HTMLElement>('.esa-stat__sub');
          if (value) value.textContent = tile.value;
          if (sub) sub.textContent = tile.sub;
        }
      };

      const noteChart = (data: PanelData): void => {
        // Month axes carry no year; dates and years do, as do text spans like 2016-2019.
        if (data.measure.xType === 'month') return;
        for (const y of recordYears(data.rows.map((r) => r[data.measure.x]))) years.add(y);
      };
      const noteSites = (summary: SitesSummary): void => {
        state.sites = summary;
        state.sitesState = summary.total ? 'ready' : 'empty';
        for (const y of summary.years) years.add(y);
      };

      main.addEventListener('mon-chart-panel:data', (event) => noteChart((event as CustomEvent<PanelData>).detail));
      main.addEventListener('mon-chart-panel:settled', () => {
        state.chartsPending = chartPanels.filter((p) => p.dataset.state === 'loading').length;
        render();
      });
      main.addEventListener('mon-sites:loaded', (event) => {
        noteSites((event as CustomEvent<SitesSummary>).detail);
        render();
      });
      main.addEventListener('mon-sites:settled', (event) => {
        const detail = (event as CustomEvent<{ state: 'ready' | 'empty' | 'error' }>).detail;
        if (detail.state === 'error') state.sitesState = 'error';
        render();
      });

      // Anything already settled.
      for (const panel of chartPanels) if (panel.data) noteChart(panel.data);
      state.chartsPending = chartPanels.filter((p) => p.dataset.state === 'loading').length;
      if (sitesPanel?.summary) noteSites(sitesPanel.summary);
      else if (sitesPanel?.dataset.state === 'error') state.sitesState = 'error';
      render();
    }
  </script>
</BaseLayout>
