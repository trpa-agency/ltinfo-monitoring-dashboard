---
// mon-lego-checked: esa-empty-state is the empty state. No esa-* is a plain list
// of links inside a card body (esa-link-column is a footer sitemap that inherits
// currentColor and hides its underline), so the list markup is custom.
//
// Indicators: the threshold indicators linked to a program from GET
// /monitoring-programs/{id}/indicators, each linking to its page on the
// Threshold Dashboard (thresholds.laketahoeinfo.org/indicators/{IndicatorID},
// the route the host itself links). Fetches nothing.
import EsaEmptyState from '@esa/ecology/esa-empty-state.astro';
import '@esa/tokens/typography.css';
import type { Indicator } from '../../../lib/ltinfo-api';
import { indicatorHref } from '../../../lib/ltinfo-api';

interface Props {
  indicators: Indicator[] | null | undefined;
  /** Section heading. Pass '' to render the list with no heading. */
  heading?: string;
}
const { indicators, heading = 'Threshold indicators' } = Astro.props;
const rows = (indicators ?? []).filter((i) => i && typeof i.IndicatorDisplayName === 'string' && i.IndicatorDisplayName.trim());
---
<div class="mon-indicators">
  {heading && <h3 class="mon-indicators__heading typography-label-md-strong">{heading}</h3>}
  {rows.length ? (
    <ul class="mon-indicators__list typography-body-md" aria-label={heading || 'Threshold indicators'}>
      {rows.map((i) => (
        <li>
          <a href={indicatorHref(i)} target="_blank" rel="noopener">{i.IndicatorDisplayName}</a>
        </li>
      ))}
    </ul>
  ) : (
    <EsaEmptyState
      size="sm"
      title="No indicators loaded yet."
      description="This section will show the threshold indicators linked to this program, each opening on the Threshold Dashboard."
    />
  )}
</div>

<style>
  .mon-indicators {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-200, 0.5rem);
    color: var(--color-content-default, #333333);
  }
  .mon-indicators__heading {
    margin: 0;
  }
  .mon-indicators__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-150, 0.375rem);
  }
  .mon-indicators__list a {
    color: var(--color-content-link, #337ab7);
  }
  .mon-indicators__list a:hover {
    color: var(--color-content-link-hover, #23527c);
    text-decoration: underline;
  }
</style>
